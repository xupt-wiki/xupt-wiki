{
  "extends": "@zinkawaii/tsconfig",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./docs/.vitepress/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  },
  "vueCompilerOptions": {
    "vitePressExtensions": [
      ".md"
    ]
  },
  "include": [
    "**/.*.md",
    "**/*.md",
    "**/.vitepress/**/*.ts",
    "**/.vitepress/**/*.mts"
  ]
}